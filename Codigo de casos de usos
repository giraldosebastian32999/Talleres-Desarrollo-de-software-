from abc import ABC, abstractmethod
from datetime import datetime, date
from typing import List
import uuid


class Cliente:
    def __init__(self, documento: str, nombre: str, correo: str,
                 telefono: str, direccion: str):
        self.__id = str(uuid.uuid4())[:8]
        self.__documento = documento
        self.__nombre = nombre
        self.__correo = correo
        self.__telefono = telefono
        self.__direccion = direccion
        self.__estado = "Activo"
        self.__cuentas: List["Cuenta"] = []
        self.__facturas: List["Factura"] = []
        self.__pagos: List["Pago"] = []

    @property
    def id(self) -> str:
        return self.__id

    @property
    def documento(self) -> str:
        return self.__documento

    @property
    def nombre(self) -> str:
        return self.__nombre

    @property
    def estado(self) -> str:
        return self.__estado

    def agregar_cuenta(self, cuenta: "Cuenta") -> None:
        self.__cuentas.append(cuenta)

    def agregar_factura(self, factura: "Factura") -> None:
        self.__facturas.append(factura)

    def agregar_pago(self, pago: "Pago") -> None:
        self.__pagos.append(pago)

    def obtenerFacturasPorCliente(self) -> List["Factura"]:
        return list(self.__facturas)

    def obtenerPagosPorCliente(self) -> List["Pago"]:
        return list(self.__pagos)

    def __str__(self) -> str:
        return f"Cliente({self.__nombre}, doc={self.__documento}, estado={self.__estado})"


class Cuenta(ABC):
    def __init__(self, cliente: Cliente):
        self._numero = str(uuid.uuid4())[:10].upper()
        self._cliente = cliente
        self._estado = "Activa"
        self._fecha_apertura = date.today()
        self._saldo = 0.0
        cliente.agregar_cuenta(self)

    @property
    def numero(self) -> str:
        return self._numero

    @property
    def cliente(self) -> Cliente:
        return self._cliente

    def depositar(self, monto: float) -> None:
        if monto <= 0:
            raise ValueError("El monto a depositar debe ser positivo")
        self._saldo += monto

    def debitar(self, monto: float) -> None:
        if monto > self.saldo_disponible():
            raise ValueError("Saldo o cupo insuficiente para el debito")
        self._saldo -= monto

    def obtenerSaldoCuenta(self) -> float:
        return self._saldo

    @abstractmethod
    def saldo_disponible(self) -> float:
        raise NotImplementedError

    @abstractmethod
    def calcular_rendimiento(self) -> float:
        raise NotImplementedError

    def __str__(self) -> str:
        return f"{self.__class__.__name__}({self._numero}, saldo={self._saldo:.2f})"


class CuentaAhorros(Cuenta):
    TASA_MAXIMA = 0.12

    def __init__(self, cliente: Cliente, tasa_interes: float = 0.03):
        super().__init__(cliente)
        if tasa_interes < 0 or tasa_interes > self.TASA_MAXIMA:
            raise ValueError(f"Tasa fuera de rango (0 - {self.TASA_MAXIMA})")
        self.__tasa_interes = tasa_interes

    def saldo_disponible(self) -> float:
        return self._saldo

    def calcular_rendimiento(self) -> float:
        return self._saldo * self.__tasa_interes


class CuentaCorriente(Cuenta):
    def __init__(self, cliente: Cliente, cupo_sobregiro: float = 0.0):
        super().__init__(cliente)
        self.__cupo_sobregiro = cupo_sobregiro

    def saldo_disponible(self) -> float:
        return self._saldo + self.__cupo_sobregiro

    def calcular_rendimiento(self) -> float:
        return -2.50


class Factura:
    def __init__(self, cliente: Cliente, valor: float, servicio: str):
        self.__numero = str(uuid.uuid4())[:10].upper()
        self.__cliente = cliente
        self.__valor = valor
        self.__servicio = servicio
        self.__fecha_emision = date.today()
        self.__estado = "Pendiente"
        cliente.agregar_factura(self)

    @property
    def numero(self) -> str:
        return self.__numero

    @property
    def valor(self) -> float:
        return self.__valor

    @property
    def estado(self) -> str:
        return self.__estado

    def marcar_pagada(self) -> None:
        self.__estado = "Pagada"

    def __str__(self) -> str:
        return f"Factura({self.__numero}, {self.__servicio}, ${self.__valor:.2f}, {self.__estado})"


class Pago:
    def __init__(self, cuenta: Cuenta, factura: Factura):
        self.__referencia = str(uuid.uuid4())[:12].upper()
        self.__cuenta = cuenta
        self.__factura = factura
        self.__monto = factura.valor
        self.__fecha = datetime.now()
        self.__estado = "En proceso"

    def procesarPago(self) -> None:
        if self.__estado == "Confirmado":
            raise PermissionError("Este pago ya fue procesado")
        self.__cuenta.debitar(self.__monto)
        self.__factura.marcar_pagada()
        self.__estado = "Confirmado"
        self.__cuenta.cliente.agregar_pago(self)

    @property
    def estado(self) -> str:
        return self.__estado

    def __str__(self) -> str:
        return f"Pago({self.__referencia}, ${self.__monto:.2f}, {self.__estado})"


def main():
    cliente = Cliente("123456789", "Ana Torres", "ana@correo.com", "3000000000", "Cra 1 #2-3")

    ahorros = CuentaAhorros(cliente, tasa_interes=0.05)
    corriente = CuentaCorriente(cliente, cupo_sobregiro=100)
    ahorros.depositar(200)
    corriente.depositar(50)

    cuentas: List[Cuenta] = [ahorros, corriente]
    for c in cuentas:
        print(f"{c.__class__.__name__} -> saldo: {c.obtenerSaldoCuenta():.2f}  "
              f"rendimiento: {c.calcular_rendimiento():.2f}")

    factura1 = Factura(cliente, valor=80, servicio="Energia")
    factura2 = Factura(cliente, valor=45, servicio="Agua")

    pago1 = Pago(corriente, factura1)
    pago1.procesarPago()

    pago2 = Pago(ahorros, factura2)
    pago2.procesarPago()

    print("\nFacturas del cliente:")
    for f in cliente.obtenerFacturasPorCliente():
        print(" -", f)

    print("\nPagos del cliente:")
    for p in cliente.obtenerPagosPorCliente():
        print(" -", p)


if __name__ == "__main__":
    main()
